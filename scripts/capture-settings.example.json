{
  "hooks": {
    "SessionStart":       [{ "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 5 }] }],
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 5 }] }],
    "PreToolUse":         [{ "matcher": "*", "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 5 }] }],
    "PostToolUse":        [{ "matcher": "*", "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 5 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 5 }] }],
    "PostToolBatch":      [{ "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 5 }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 5 }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "sh", "args": ["/ABSOLUTE/PATH/TO/loopguard/scripts/capture-hook.sh"], "timeout": 1 }] }]
  }
}
